ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://vita:vita@localhost:5432/vitaclan
SYNC_DATABASE_URL=postgresql://vita:vita@localhost:5432/vitaclan

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Firebase (Phone OTP) — fill from console.firebase.google.com
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Ollama (Self-hosted LLMs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.3:70b
OLLAMA_VISION_MODEL=llava:13b

# MinIO (Local dev) → AWS S3 ap-south-1 (Production)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vitaclan-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1
S3_USE_SSL=false

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vitaclan-webhook-verify

# Firebase Cloud Messaging (Push notifications)
FCM_SERVER_KEY=

# Google Cloud Vision (OCR fallback)
GOOGLE_CLOUD_CREDENTIALS_PATH=

# AI rate limits (free tier)
FREE_TIER_AI_SUMMARIES_PER_MONTH=5
FREE_TIER_VOICE_QUERIES_PER_MONTH=10
